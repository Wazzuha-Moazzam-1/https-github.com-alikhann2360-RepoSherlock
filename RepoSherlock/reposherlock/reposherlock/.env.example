# Copy this file to .env and fill in your values. NEVER commit .env.
# Get these from https://app.dnotifier.com  (your app "RepoSherlock")
DNOTIFIER_APP_ID=
DNOTIFIER_SECRET=

# Optional: identities used inside your one DNotifier app
DNOTIFIER_AGENT_USER_ID=reposherlock-agent
DNOTIFIER_ACK_USER_ID=reposherlock-ack
DNOTIFIER_MONITOR_USER_ID=reposherlock-monitor
# 1 = also store events in DNotifier chat history (uses plan storage)
DNOTIFIER_SAVE_HISTORY=0

# Local AI (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT=180
